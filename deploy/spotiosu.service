[Unit]
Description=spotiosu web app
Documentation=https://github.com/byteown/spotiosu
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=exec
User=deploy
Group=deploy
WorkingDirectory=/opt/spotiosu/app
EnvironmentFile=/opt/spotiosu/.env
ExecStart=/opt/spotiosu/venv/bin/python -m webapp
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

# NOTE: deliberately no PrivateTmp / ProtectSystem / ProtectHome here.
# Those rely on mount namespaces, which an OpenVZ container does not allow -
# enabling them makes the unit fail to start on this host.
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=spotiosu

[Install]
WantedBy=multi-user.target
