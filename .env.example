# Server-side environment, deployed to /opt/spotiosu/.env by deploy/setup-server.sh.
# NEVER commit the real file.

# --- osu! OAuth application (https://osu.ppy.sh/home/account/edit) ------------
SPOTIOSU_CLIENT_ID=63675
SPOTIOSU_CLIENT_SECRET=replace-me

# --- public address; must match the osu! app's callback URL ------------------
SPOTIOSU_PUBLIC_BASE=https://spotiosu.ru

# --- the app binds to loopback; Caddy proxies to it --------------------------
SPOTIOSU_HOST=127.0.0.1
SPOTIOSU_PORT=8000

# --- signs session cookies. Generate once, keep stable: openssl rand -hex 32 --
SPOTIOSU_SESSION_SECRET=replace-me

# --- database (setup-server.sh fills in the generated password) --------------
SPOTIOSU_DSN=postgresql://spotiosu:replace-me@127.0.0.1:5432/spotiosu

# --- optional "Support" button. Leave empty to hide it entirely. -------------
# Any URL: DonationAlerts, Boosty, Ko-fi... swapping platforms needs no redeploy
# of code, only this value plus a restart.
SPOTIOSU_DONATE_URL=
